import React, { useEffect, useState } from 'react';

interface LoadingScreenProps {
  onLoaded: () => void;
}

export const LoadingScreen: React.FC<LoadingScreenProps> = ({ onLoaded }) => {
  const [progress, setProgress] = useState(0);

  useEffect(() => {
    // Список картинок, которые нужно полностью закешировать
    const assetsToPreload = [
      '/MainMenuBackground.png',
      '/RiccarLogo.png'
    ];

    let loadedCount = 0;
    const totalAssets = assetsToPreload.length;

    // Плавное заполнение полоски
    assetsToPreload.forEach((src) => {
      const img = new Image();
      img.src = src;
      img.onload = img.onerror = () => {
        loadedCount++;
        const targetPercent = Math.round((loadedCount / totalAssets) * 100);
        setProgress((prev) => Math.max(prev, targetPercent));
      };
    });

    // Имитация гладкого заполнения, если картинки подтянулись слишком быстро
    const timer = setInterval(() => {
      setProgress((prev) => {
        if (prev >= 100) {
          clearInterval(timer);
          setTimeout(onLoaded, 350); // Мягкий переход в меню
          return 100;
        }
        return prev + 2;
      });
    }, 25);

    return () => clearInterval(timer);
  }, [onLoaded]);

  return (
    <div style={styles.container}>
      <div style={styles.centerStage}>
        {/* Контейнер логотипа с заполнением снизу вверх */}
        <div style={styles.logoBox}>
          {/* Полупрозрачное базовое лого */}
          <img 
            src="/RiccarLogo.png" 
            alt="Riccaree Logo" 
            style={styles.logoBase}
            draggable={false}
          />
          {/* Яркое лого, обрезаемое по высоте снизу вверх */}
          <img 
            src="/RiccarLogo.png" 
            alt="Riccaree Logo Fill" 
            style={{
              ...styles.logoFill,
              clipPath: `inset(${100 - progress}% 0 0 0)`
            }}
            draggable={false}
          />
        </div>

        {/* Прогресс-бар снизу */}
        <div style={styles.progressBarWrapper}>
          <div style={styles.progressBarTrack}>
            <div 
              style={{
                ...styles.progressBarFill,
                width: `${progress}%`
              }} 
            />
          </div>
          <span style={styles.progressText}>{progress}%</span>
        </div>
      </div>
    </div>
  );
};

